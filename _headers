# P19 (v203) — পুরোনো বান্ডেল-ক্যাশ-স্টিকিনেস চিরকাল-নিষেধ
# আপডেট-প্রবাহ নিশ্চিত: sw.js ও index.html কখনো HTTP-ক্যাশে আটকাবে না।
# NOTE (v323, owner bug 2026-10-13): the register() call previously used
#   './sw.js?v=<build>'. A versioned JS URL matches the `/*.js?v=*` rule at the
#   bottom of this file (immutable, max-age=31536000), which contradicted this
#   block and pinned an old, broken worker on every device forever — the exact
#   cause of the recurring "This site can't be reached / ERR_FAILED". The
#   registration now uses the bare './sw.js' so ONLY the no-store rule below
#   applies, and every device picks up each new worker on the next load.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/dashboard-v2.js
  Cache-Control: no-cache, no-store, must-revalidate

/verification-control-center
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'sha256-3Wvz5dnFVDvTd82OyUWDKlLpd2pQCbhhUF16xoNzX7k='; style-src 'sha256-ISpUa2hAF3Be5xsNT/e0dDHWrNtQqjEIhnXPunOdIqQ='; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; img-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/verification-control-center.html
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'sha256-3Wvz5dnFVDvTd82OyUWDKlLpd2pQCbhhUF16xoNzX7k='; style-src 'sha256-ISpUa2hAF3Be5xsNT/e0dDHWrNtQqjEIhnXPunOdIqQ='; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; img-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/phase3-intelligence.js*
  Cache-Control: no-cache, no-store, must-revalidate

/daily-streak-card.js*
  Cache-Control: no-cache, no-store, must-revalidate

/dashboard-greeting-3d.js*
  Cache-Control: no-cache, no-store, must-revalidate

# SEO / crawler files — never cache stale, and never let Pages guess the MIME type.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# Owner-only voice page PWA manifest (see voice-agent.webmanifest).
/voice-agent.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# Social preview assets.
/og-image.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Internal preview surfaces must stay out of the index even if linked.
/splash-preview
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0

/splash-preview.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0

/ai-performance-analysis-live.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0

# Admin Notification Command Center — admin-only surface, never indexed.
/notification-command-center
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0
  Referrer-Policy: no-referrer

/notification-command-center.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0
  Referrer-Policy: no-referrer


# P13 — fingerprinted static assets (a ?v= query) can never change under their
# URL, so the browser keeps them for a year and never revalidates. The shell
# (/sw.js, /index.html) stays no-store above; an asset without a version stamp
# is left to the default, so a stale bundle still can never stick.
/*.js?v=*
  Cache-Control: public, max-age=31536000, immutable

/*.css?v=*
  Cache-Control: public, max-age=31536000, immutable

/*.png?v=*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2?v=*
  Cache-Control: public, max-age=31536000, immutable
