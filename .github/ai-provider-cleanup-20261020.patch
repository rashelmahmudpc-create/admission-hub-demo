+/* Value that marks a keyless provider slot as switched on. */
+export const ANON_KEY = 'anon';
+
+/* Extra OpenAI-compatible providers declared in data, so a new provider needs
+ * no code change or deploy: `AI_EXTRA_PROVIDERS` (env or a string inside
+ * secret:AI_KEYS) holds a JSON array of {key, url, models}. `key` names the
+ * slot that holds the credential (or `anon`). Only https URLs are accepted and
+ * a malformed value is ignored, never thrown. Appended after the built-ins. */
+export function extraProviders(env, kv = {}) {
+  const raw = (env && env.AI_EXTRA_PROVIDERS) || kv.AI_EXTRA_PROVIDERS || '';
+  if (!raw) return [];
+  let list;
+  try { list = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (_) { return []; }
+  if (!Array.isArray(list)) return [];
+  return list.filter(p => p && typeof p === 'object'
+    && /^[A-Z0-9_]{2,64}$/.test(String(p.key || ''))
+    && /^https:\/\/[^\s]+$/.test(String(p.url || ''))
+    && Array.isArray(p.models) && p.models.some(m => typeof m === 'string' && m.trim()))
+    .slice(0, 40)
+    .map(p => ({ key: String(p.key), url: String(p.url), models: p.models.filter(m => typeof m === 'string' && m.trim()).map(m => m.trim()) }));
+}
+
+
 /* Provider keys that live in KV rather than as Worker variables. The Workers Free
    plan caps a Worker at 64 variables and admission-gk sits on that cap, so a new
    key cannot be bound with `wrangler secret put`. GK_KV and PUB_KV are the same
@@ -843,7 +867,7 @@ export function routerChain(env, tier, badSet = new Set(), kv = {}) {
      A comma-separated value yields one chain entry per key, the same shape
      GEMINI_KEYS already uses, so a second key for a provider is rotated to
      instead of being sent verbatim as a single invalid credential. */
-  for (const p of COMPAT_PROVIDERS) {
+  for (const p of COMPAT_PROVIDERS.concat(extraProviders(env, kv))) {
     const keys = String(pickKey(env, kv, p.key) || '').split(',').map(s => s.trim()).filter(Boolean);
     if (!keys.length) continue;
     const models = String((env && env[p.key + '_MODELS']) || kv[p.key + '_MODELS'] || '')
@@ -852,7 +876,7 @@ export function routerChain(env, tier, badSet = new Set(), kv = {}) {
       for (const m of (models.length ? models : p.models)) {
